# RTSP 流地址（go2rtc 输出的 RTSP）
RTSP_URL=rtsp://192.168.1.100:8554/live

# ASR 引擎：aliyun / tencent / openai
ASR_ENGINE=aliyun

# --- 阿里云百炼 ---
# 在 https://bailian.console.aliyun.com/ 申请
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
ASR_MODEL=paraformer-realtime-v2

# --- 腾讯云一句话识别 ---
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-shanghai

# --- OpenAI 兼容接口 ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=whisper-1

# VAD 静音检测（也可在 Web 页面调整，Web 配置优先）
VAD_MODE=3
VAD_FRAME_MS=30
VAD_SILENCE_FRAMES=10
VAD_MIN_SPEECH_FRAMES=3

# 日志级别
LOG_LEVEL=INFO

# 服务端口
HTTP_PORT=8000

# 数据库与 Web 设置的持久化路径
DB_PATH=/data/asr.db
SETTINGS_PATH=/data/settings.json
