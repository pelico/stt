# RTSP 流地址（go2rtc 输出的 RTSP）
RTSP_URL=rtsp://192.168.1.100:8554/live

# 容器时区：识别时段、日志时间戳都按这个来（compose 里用 TZ 环境变量）
# 不设会用 UTC，时段判断会整体差 8 小时
TZ=Asia/Shanghai

# ASR 引擎：aliyun / tencent / openai
ASR_ENGINE=aliyun

# --- 阿里云百炼 ---
# 在 https://bailian.console.aliyun.com/ 申请
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
ASR_MODEL=paraformer-realtime-v2

# --- 腾讯云一句话识别 ---
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-shanghai

# --- OpenAI 兼容接口 ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=whisper-1
# 单次识别超时（秒），连续失败 3 次会熔断退避
ASR_TIMEOUT=45
# 语音段在识别队列里最长等待（秒）：ASR 慢时丢弃过期片段，不补识别几十秒前的话
# 0 = 不限制；也可在 Web 设置页「队列最长等待」热更新
ASR_MAX_QUEUE_AGE=10

# VAD 静音检测（也可在 Web 页面调整，Web 配置优先）
VAD_MODE=3
VAD_FRAME_MS=30
# 断句静音 20 帧 = 600ms（旧版 10 帧太碎）
VAD_SILENCE_FRAMES=20
# 最短语音 10 帧 = 300ms（旧版 3 帧会被咳嗽/开关门误触发）
VAD_MIN_SPEECH_FRAMES=10
# 一段里真语音帧的最低占比，噪声往往只有零星几帧
VAD_MIN_SPEECH_RATIO=0.5
# 句首补帧 / 句尾保留静音（毫秒）
VAD_PREROLL_MS=200
VAD_TAIL_PAD_MS=150
# 能量门限 dBFS，-80 ~ -10
VAD_RMS_DBFS=-45

# ffmpeg：高通滤波（Hz，0 关闭）、拉流超时（秒，同时作无数据看门狗）
FFMPEG_HIGHPASS=100
FFMPEG_TIMEOUT=20

# 噪音结果过滤
FILTER_NOISE_TEXT=true
FILTER_IGNORE_WORDS=嗯,啊,here,shoes

# 被过滤音频留证（调试用，默认关，最多保留文件数）
SAVE_REJECTED_AUDIO=false
REJECTED_AUDIO_MAX=50

# 可选访问口令：留空=不启用；启用后用 ?token=xxx 打开一次页面即可
ACCESS_TOKEN=

# 日志级别
LOG_LEVEL=INFO

# 服务端口
HTTP_PORT=8000

# 数据库与 Web 设置的持久化路径
DB_PATH=/data/asr.db
SETTINGS_PATH=/data/settings.json
