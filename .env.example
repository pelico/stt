# RTSP 流地址（go2rtc 输出的 RTSP）
RTSP_URL=rtsp://192.168.1.100:8554/live

# 阿里云百炼 API Key（在 https://bailian.console.aliyun.com/ 申请）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# ASR 模型
ASR_MODEL=paraformer-realtime-v2

# VAD 静音检测模式 (0-3, 越大越激进)
VAD_MODE=3

# 日志级别
LOG_LEVEL=INFO

# 服务端口
HTTP_PORT=8000

# 数据库路径
DB_PATH=/data/asr.db
