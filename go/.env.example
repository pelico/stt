# 复制为 .env 使用：cp .env.example .env
# 注意：.env 不会被提交到 Git。

# 音频流地址（rtsp:// 或 http:// 的音频流）
RTSP_URL=

# ---- ASR 引擎（三选一）----
# aliyun（默认）
ASR_ENGINE=aliyun
DASHSCOPE_API_KEY=

# openai 兼容接口（接口地址按需填写，不预置）
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=sensevoice-small

# 腾讯云
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=

# 页面访问口令（留空则无需登录；也可运行时在设置里修改）
ACCESS_TOKEN=
